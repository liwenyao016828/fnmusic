#!/bin/bash
# ==============================================================================
#  飞牛 OS (fnOS) 曲率应用生命周期核心控制脚本 (start / stop / status)
#
#  ⚠️ 本应用与旧的「极光音乐」(appname=fn-lx-player) 是**两个独立应用**：
#     · 不同的 appname → 飞牛不会当成升级，可以并存
#     · 不同的端口（本应用 8898，旧应用 8899）→ 两个都能跑
#     · 下面所有进程名/路径匹配都用 yinshu-ai，**绝不能出现 fn-lx-player**，
#       否则停本应用会把旧应用一起杀掉
# ==============================================================================

APP_DIR="${TRIM_APPDEST:-$(cd "$(dirname "$0")/.." && pwd)}"
APP_NAME="${TRIM_APPNAME:-yinshu-ai}"
VAR_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"
BIN_NAME="yinshu-ai"
APP_PORT=8898

# 动态探测二进制路径（适配平铺和保留层级两种情况）
if [ -f "${APP_DIR}/${BIN_NAME}" ]; then
  BIN_PATH="${APP_DIR}/${BIN_NAME}"
elif [ -f "${APP_DIR}/app/${BIN_NAME}" ]; then
  BIN_PATH="${APP_DIR}/app/${BIN_NAME}"
else
  BIN_PATH="${APP_DIR}/${BIN_NAME}"
fi

PID_FILE="${VAR_DIR}/${APP_NAME}.pid"
DATA_DIR="${VAR_DIR}/data"

# ── 统一网关（微应用）的 socket ────────────────────────────────────────────
#
# 飞牛桌面不再直连 8898 端口，而是走官方「统一网关」：app/ui/config 里声明
# gatewayPrefix=/app/yinshu-ai + gatewaySocket=app.sock，网关（trim_http_cgi）
# 把 /app/yinshu-ai/** 的请求转发到**这个 socket**。
#
# 两条硬约束（官方文档 + 真机实测）：
#   1. socket 文件必须落在 target 目录（TRIM_APPDEST），网关只认那儿；
#   2. gatewayPrefix 必须与 app/ui/config 一致，否则页面打开一片 404。
#
# TCP 端口（8898）**保留**：manifest 的 service_port 是它，应用中心探活、
# 「边听边下」落盘回调（进程内打 127.0.0.1:8898）都还依赖它。所以这里是并行，
# 不是替换。
GATEWAY_PREFIX="/app/yinshu-ai"
GATEWAY_SOCKET="${APP_DIR}/app.sock"

# 日志写到内存文件系统 /tmp，避免写到机械硬盘触发唤醒
LOG_FILE="/tmp/${APP_NAME}.log"

mkdir -p "${VAR_DIR}" "${DATA_DIR}"

log_error() {
    local msg="$1"
    echo "$msg"
    if [ -n "$TRIM_TEMP_LOGFILE" ]; then
        echo "$msg" > "$TRIM_TEMP_LOGFILE"
    fi
}

# ── 兜底：按端口找「上一代残留的 lx 宿主」并收掉 ──────────────────────────
#
# 2026-11-02 真机故障：停服务只杀主进程（kill "$PID" + pkill 二进制名），而后端拉起的
# Node 宿主不在 PID 文件里、进程名也不是 yinshu-ai，于是它被 init 收养（实测 PPID=1），
# 继续占着 8920。下一代后端起来时健康检查由这个老进程应答，误判「已就绪」，真正拉起
# 自己的子进程时 EADDRINUSE 秒退 —— lx 功能就这么一直 failed。
#
# 这里的判据**是端口**（/proc/net/tcp 里该端口的 LISTEN socket），不是进程名：
# pkill node 会把用户自己跑的其它 Node 程序一起杀掉。
#
# 脚本能读到 /proc/<pid>/fd 才能反查，root 下没有权限问题；查不到就只提示、不动手。
LX_HOST_PORT="${QULV_LX_PORT:-8920}"

pids_on_port() {
    local port="$1"
    local hexport inodes line inode pid fd link
    hexport=$(printf ':%04X' "$port")
    [ -r /proc/net/tcp ] || return 0
    inodes=""
    while read -r line; do
        # 字段：sl local_address rem_address st ... uid timeout inode
        # st=0A 是 LISTEN；其余状态（TIME_WAIT 等）不是「端口被占」，不能算进来。
        case "$line" in
            *" $hexport "*" 0A "*) ;;
            *) continue ;;
        esac
        inode=$(echo "$line" | awk '{print $10}')
        [ -n "$inode" ] && inodes="$inodes $inode"
    done < /proc/net/tcp
    [ -n "$inodes" ] || return 0
    for pid in $(ls /proc 2>/dev/null | grep -E '^[0-9]+$'); do
        [ -d "/proc/$pid/fd" ] || continue
        for fd in "/proc/$pid/fd"/*; do
            link=$(readlink "$fd" 2>/dev/null) || continue
            case "$link" in
                socket:\[*\])
                    for inode in $inodes; do
                        if [ "$link" = "socket:[$inode]" ]; then
                            echo "$pid"
                            break 2
                        fi
                    done
                    ;;
            esac
        done
    done
}

kill_stale_lx_host() {
    local pids pid
    pids=$(pids_on_port "$LX_HOST_PORT" | sort -u)
    if [ -z "$pids" ]; then
        return 0
    fi
    for pid in $pids; do
        echo "清理上一代残留的 lx 宿主进程 (PID: $pid，端口 ${LX_HOST_PORT})."
        # 负号 = 整个进程组；宿主以 Setpgid 启动，这样它的子进程也不会留下来。
        kill -TERM "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    done
    sleep 1
    for pid in $pids; do
        if kill -0 "$pid" 2>/dev/null; then
            kill -9 "-$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
        fi
    done
}

# ── 读 ${VAR_DIR}/.env 作为环境变量入口 ────────────────────────────────────
#
# 飞牛启动应用时只给一组固定的 TRIM_* 变量，没有「应用自定义环境变量」的界面。
# 而本项目有些能力（目前是音乐入口接管 QULV_TAKEOVER）需要用户自己开开关。
# 没有这个文件，用户唯一的办法是去改这个脚本本身 —— 下次升级就被覆盖了。
#
# 路径就是数据目录（/vol1/@appdata/<appname>/.env，/var/apps/<appname>/var 是
# 它的软链），和 fnmusic-ext 放 .env 的位置一致，用户不用记两套。
#
# set -a 让 source 进来的变量自动 export；文件不存在就静默跳过，
# 写坏了也只警告不拦启动 —— 这个文件的权限只属于 root，不是攻击面。
#
# ── 先落盘「安装向导 / 配置向导」填的内容 ──────────────────────────────────
#
# wizard/install、wizard/config 里的字段（wizard_music_dir 等）只存在于跑生命
# 周期脚本的那一次进程环境里，而后端是常驻进程 —— 重启之后就再也拿不到了。
# _wizard 负责把它们写进 ${VAR_DIR}/env.d/，**必须在下面 source 环境之前跑**，
# 否则这一次启动仍然读不到用户刚填的值。
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "${SELF_DIR}/_wizard" ]; then
    # shellcheck source=/dev/null
    . "${SELF_DIR}/_wizard"
    qulv_apply_wizard "${VAR_DIR}"
fi

ENV_FILE="${VAR_DIR}/.env"
if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    if ! . "$ENV_FILE" 2>/dev/null; then
        echo "警告: ${ENV_FILE} 解析失败，本次启动忽略其中的设置"
    fi
    set +a
fi

# 向导值放在 env.d/ 里，一个变量一个文件；目录不存在就跳过。
if [ -d "${VAR_DIR}/env.d" ]; then
    set -a
    for _wf in "${VAR_DIR}"/env.d/*; do
        [ -f "$_wf" ] || continue
        # shellcheck disable=SC1090
        . "$_wf" 2>/dev/null || echo "警告: 向导设置 ${_wf} 解析失败，已忽略"
    done
    set +a
    unset _wf
fi

case "$1" in
  start)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "${APP_NAME} 已经在运行中 (PID: $(cat "$PID_FILE"))."
      exit 0
    fi

    echo "正在启动 ${APP_NAME}..."
    chmod +x "${BIN_PATH}" 2>/dev/null || true
    chmod +x "${APP_DIR}/${BIN_NAME}" 2>/dev/null || true
    chmod +x "${APP_DIR}/app/${BIN_NAME}" 2>/dev/null || true

    if [ ! -f "${BIN_PATH}" ]; then
      log_error "未找到可执行文件: ${BIN_PATH} (APP_DIR: ${APP_DIR})"
      exit 1
    fi

    # 残留 socket 先清掉：上一次被 kill -9 时文件会留在盘上，而 bind 已存在的
    # unix socket 会直接失败（后端也有同样的清理，这里是双保险 —— 后端若因权限
    # 删不掉，脚本以 root 跑总删得掉）。
    rm -f "${GATEWAY_SOCKET}"

    # 残留的 lx 宿主同理：后端自己也会清（lxnode.clearStaleHost），但后端以应用 uid
    # 运行、杀不掉 root 的残留；这个脚本以 root 跑，能把那一类也收掉。
    kill_stale_lx_host

    # 启动后台守护进程，日志写入 /tmp
    #
    # setsid：让主进程成为**新会话 + 新进程组的组长**。这是 stop 能「整组收掉」的前提 ——
    # 后端拉起的 lx 宿主 / Python sidecar 都在这棵树上，只杀主 PID 会留下占着端口的孤儿。
    # PID 文件依然有效：$! 就是 setsid 之后那个进程的 pid（setsid 直接 exec，不再 fork
    # 一层，因为这里的调用方不是进程组组长）。
    nohup setsid "${BIN_PATH}" --port ${APP_PORT} --data "${DATA_DIR}" --socket "${GATEWAY_SOCKET}" > "${LOG_FILE}" 2>&1 &
    DAEMON_PID=$!
    echo "$DAEMON_PID" > "$PID_FILE"

    # 等待进程确认启动
    for i in {1..10}; do
      if kill -0 "$DAEMON_PID" 2>/dev/null; then
        echo "${APP_NAME} 启动成功 (PID: ${DAEMON_PID})."
        exit 0
      fi
      sleep 0.2
    done

    log_error "${APP_NAME} 启动失败，请查看日志: ${LOG_FILE}"
    exit 1
    ;;

  stop)
    echo "正在停止 ${APP_NAME}..."
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      if kill -0 "$PID" 2>/dev/null; then
        # 先对**整个进程组**发 TERM（start 用 setsid 起了新组），再单独点一次主进程，
        # 兼容「老版本没用 setsid 启动、进程组里还有别人」的情况 —— 那时 kill 负 pid
        # 会失败，单独这一条兜底仍然有效。
        kill -TERM "-$PID" 2>/dev/null || true
        kill -TERM "$PID" 2>/dev/null || true
        for i in {1..10}; do
          if ! kill -0 "$PID" 2>/dev/null; then
            break
          fi
          sleep 0.3
        done
        kill -9 "-$PID" 2>/dev/null || true
        kill -9 "$PID" 2>/dev/null || true
      fi
      rm -f "$PID_FILE"
    else
      pkill -f "${BIN_PATH}" 2>/dev/null || true
      # 只按本应用自己的进程名匹配 —— 不能写 fn-lx-player，
      # 否则会把并存的旧「极光音乐」一起杀掉
      pkill -f "${BIN_NAME}" 2>/dev/null || true
    fi
    # 兜底：主进程已经没了，但 lx 宿主可能还占着端口（上一代没被整组停掉的残留）。
    # 不收掉它的话，下一次 start 之后 lx 会一直 failed。
    kill_stale_lx_host
    # 进程没了 socket 文件还在的话，网关会一直往一个没人接的 socket 转发，
    # 表现是「应用页打开一片空白但进程状态正常」。停服务时顺手清掉。
    rm -f "${GATEWAY_SOCKET}"
    echo "${APP_NAME} 已停止."
    exit 0
    ;;

  status)
    if [ -f "$PID_FILE" ]; then
      PID=$(cat "$PID_FILE")
      if kill -0 "$PID" 2>/dev/null; then
        exit 0 # 0 表示正常运行中 (fnOS 规范)
      fi
    fi

    if pgrep -f "${BIN_PATH}" >/dev/null 2>&1; then
      exit 0
    fi

    exit 3 # 3 表示未运行 (fnOS 规范)
    ;;

  restart)
    # 「配置向导」保存后由 config_callback 调过来：光写配置不重启，用户是看不到变化的。
    "$0" stop
    exec "$0" start
    ;;

  *)
    echo "使用方法: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
