#!/bin/bash
# ==============================================================================
#  曲率（yinshu-ai）—— 升级**前**同样打一份用户数据归档
#
#  落点/命名/保留策略与卸载路径**完全一致**（同一份 _backup、同一个卷根、
#  同一个轮转池）：升级失败被回滚、以至于要走「卸载重装」时，这份归档就是
#  逃生通道。
#
#  ⚠️ 与参考实现（fnmusic-ext）刻意不同的地方：
#     那边把升级备份放进 ${TRIM_PKGVAR}/upgrade-backup/data.tar.gz，再由
#     upgrade_callback 解开还原、然后 rm -rf 掉。曲率**不做**那条路，理由有三：
#       ① 曲率的数据目录本来就不在应用目录里（/vol1/@appdata/yinshu-ai 与
#          /vol1/appcenter 下的应用目录是两棵树），fNOS 换掉应用文件不会碰它；
#       ② 有真机旁证：v2.1.83 → v2.1.84 升级后 sidecar 的 venv 与 .deps-ok
#          原样保留、没重装依赖（docs/变更记录/2026-10-06.md:1322）；后端代码
#          自己也写着侧车数据目录「必须是升级不丢的位置」
#          （backend/pkg/sidecar/sidecar.go:50）。也就是说正常升级不丢数据，
#          参考实现那条「备份→还原」链路在曲率这里没有要解决的问题；
#       ③ 那条链路把备份和还原绑成一对：回调没跑到（或跑到一半失败），备份就
#          白打了。曲率只做「打一份放好的归档」，还原是人（或以后真要时再加的
#          一步）的事，还原命令写在日志里。
#
#  失败/超时：记日志然后**继续升级**。
# ==============================================================================
set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "${SELF_DIR}/_backup" ]; then
    # shellcheck source=/dev/null
    . "${SELF_DIR}/_backup"
    qulv_make_backup upgrade
else
    echo "[qulv-backup] 未找到 ${SELF_DIR}/_backup，跳过升级前备份（不阻塞升级）" >&2
fi

exit 0
