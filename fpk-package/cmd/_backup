#!/bin/bash
# ==============================================================================
#  曲率（yinshu-ai）—— 生命周期脚本共用的「用户数据备份」实现（被 source，不单独执行）
#
#  为什么单独一个文件：卸载与升级两条路径要做**同一件**事（定位数据目录 → 限时
#  打包 → 轮转保留）。写成两份拷贝迟早漂移，而漂移的方向正好是「丢数据」那一侧。
#
#  ⚠️ 纪律：本文件里每一处都**不许让调用方失败**。
#     备份是保险，不能变成新的故障点 —— 打包失败、超时、没权限、目录不存在，
#     一律记日志后 return 0，卸载/升级照常走完。
#     （参考实现 fnmusic-ext 在这一点上是相反的：那边 tar 失败会 fnmusic_fail
#       并**中止卸载**。曲率明确不要那个行为 —— 见任务 E 第 2 条。）
#
#  ⚠️ 本文件只用 POSIX sh 也认的语法（没有数组、没有 mapfile），这样 cmd/ 下
#     所有脚本都还能用 `sh -n` 做语法检查 —— 与既有脚本保持一致。用到的
#     `local` 是 dash 也支持的扩展。
#
#  调用方约定：
#    · 先设 SELF_DIR=<cmd 目录绝对路径>
#    · 不要开 set -e
# ==============================================================================

# 技术标识：manifest 里的 appname。**刻意写死字面量、不取 TRIM_APPNAME** ——
# 归档名前缀和轮转通配都靠它，一旦两次生命周期调用取值不同，旧归档就再也轮转
# 不掉。（manifest 里也写着 appname 不能改：改了飞牛会当成新应用安装。）
QULV_APP_NAME="yinshu-ai"
QULV_ARCHIVE_PREFIX="${QULV_APP_NAME}-backup-"

# 保留份数与限时，可用环境变量覆盖（运维口子 + 测试口子）。
QULV_KEEP_BACKUPS="${QULV_KEEP_BACKUPS:-5}"
QULV_BACKUP_TIMEOUT="${QULV_BACKUP_TIMEOUT:-120}"
# 归档复核的单独预算：只有 tar 出错时才用到（见 qulv_archive_readable）。
# 归档本来就小（缓存都排除了），所以这个值给得很短 —— 短才对，它的作用是
# 「快速判定这份 .part 能不能用」，不是「耐心等它读完」。
QULV_BACKUP_VERIFY_TIMEOUT="${QULV_BACKUP_VERIFY_TIMEOUT:-30}"

# ── 日志 ─────────────────────────────────────────────────────────────────────
# 每一行都同时进 **stderr** 和 ${VAR_DIR}/qulv-backup.log。
#
# ⚠️ 必须走 stderr，不能走 stdout：本文件里的定位函数（qulv_var_dir /
#    qulv_backup_root）是**用 stdout 返回路径值**的，而调用处是
#    `root="$(qulv_backup_root ...)"` —— 只要函数里往 stdout 打一行日志，那行
#    日志就会被当成返回值吃进 root（本地干跑抓到的：root 变成一个两行的字符串，
#    后面所有 [ -d ] 判断全部走偏）。stdout 只留给机器可读的值。
#    成功时 qulv_make_backup 额外往 stdout 打一行**只有归档路径**，给工具用
#    （参考实现的 uninstall_init 也是把归档路径 echo 到 stdout）。
#
# 已知局限：日志文件在数据目录里，卸载成功后它自己也随之消失 —— 所以每一条都
# 同时打到 stderr（飞牛会收走生命周期脚本的输出）。参考实现同样把日志放在
# TRIM_PKGVAR 下，只是另有一份不随回滚删除的 /var/log 副本；曲率不新建系统级
# 日志目录，保持「只碰自己的数据目录」。
QULV_BACKUP_LOG=""
qulv_log() {
    local line
    line="[qulv-backup] $(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo '?') $*"
    printf '%s\n' "${line}" >&2
    if [ -n "${QULV_BACKUP_LOG}" ]; then
        printf '%s\n' "${line}" >> "${QULV_BACKUP_LOG}" 2>/dev/null || true
    fi
}

# ── 目录定位：数据目录的根（= ${TRIM_PKGVAR}） ───────────────────────────────
# 唯一真源是 cmd/main 里的两行：
#     VAR_DIR="${TRIM_PKGVAR:-${APP_DIR}/var}"     真机 = /vol1/@appdata/yinshu-ai
#     DATA_DIR="${VAR_DIR}/data"                   真机 = /vol1/@appdata/yinshu-ai/data
# 后端只知道自己被 --data 指到哪（backend/main.go 的 flag "data"）。
# 真机旁证：scripts/nas-acceptance.mjs 直接读 .../yinshu-ai/data/online/downloaded.json；
#           HANDOVER.md 记同目录的 .env（/vol1/@appdata/yinshu-ai/.env 与
#           /var/apps/yinshu-ai/var/.env 是同一份，后者是前者的软链）。
qulv_var_dir() {
    local cand
    if [ -n "${TRIM_PKGVAR:-}" ] && [ -d "${TRIM_PKGVAR}" ]; then
        printf '%s\n' "${TRIM_PKGVAR%/}"
        return 0
    fi
    # TRIM_PKGVAR 缺失时的兜底：真机形态 /vol{n}/@appdata/<appname>。
    # 刻意**不硬编码 /vol1** —— 应用可以被装到任意卷（参考实现里整套「迁卷自愈」
    # 逻辑就说明换卷是真实场景）。
    for cand in /vol*/@appdata/"${QULV_APP_NAME}"; do
        if [ -d "${cand}" ]; then
            printf '%s\n' "${cand}"
            return 0
        fi
    done
    # 最后退回与 cmd/main 完全相同的表达式：APP_ROOT/var
    if [ -n "${SELF_DIR:-}" ] && [ -d "${SELF_DIR}/.." ]; then
        printf '%s\n' "$(cd "${SELF_DIR}/.." && pwd)/var"
        return 0
    fi
    return 1
}

# 从一条路径里抠出卷根 /vol{n}（抠不出来什么都不打印）。
# 写成独立函数是为了让下面三个候选各调一次，而不是去维护一个候选数组
# （候选数组在 POSIX sh 下得靠字符串拼接，比这个难读）。
#
