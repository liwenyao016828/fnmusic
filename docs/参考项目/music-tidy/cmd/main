#!/bin/bash
### MusicTidy 生命周期脚本

APP_DIR="${TRIM_APPDEST}/server"
PY_SCRIPT="${APP_DIR}/music_tidy.py"
PID_FILE="${TRIM_PKGVAR}/app.pid"
LOG_FILE="${TRIM_PKGVAR}/app.log"
SOCKET_FILE="${TRIM_APPDEST}/app.sock"

find_python() {
    local p
    # 优先 fnOS 官方运行时，其次系统 python3
    for p in \
        "/var/apps/python312/target/bin/python3" \
        "/usr/local/trim/runtime/python312/bin/python3" \
        "/opt/python312/bin/python3" \
        "${TRIM_RUNTIME_PYTHON:-}" \
        "/usr/local/bin/python3" \
        "/usr/bin/python3"; do
        if [ -n "$p" ] && [ -x "$p" ]; then
            echo "$p"
            return 0
        fi
    done
    if command -v python3 >/dev/null 2>&1; then
        command -v python3
        return 0
    fi
    return 1
}

log_msg() {
    mkdir -p "${TRIM_PKGVAR:-/tmp}" 2>/dev/null
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid=$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

start_app() {
    if is_running; then
        return 0
    fi
    local PY
    # 官方建议：将运行时 bin 加入 PATH（运行时不一定自动注入 PATH）
    if [ -d "/var/apps/python312/target/bin" ]; then
        export PATH="/var/apps/python312/target/bin:$PATH"
    fi
    PY=$(find_python)
    if [ -z "$PY" ]; then
        log_msg "未找到 python3 运行时"
        echo "未找到 python3 运行时，请确认系统已安装 python312 依赖。" > "${TRIM_TEMP_LOGFILE:-/tmp/music-tidy-install.log}"
        return 1
    fi
    if [ ! -f "$PY_SCRIPT" ]; then
        log_msg "主程序缺失: $PY_SCRIPT"
        echo "主程序文件缺失。" > "${TRIM_TEMP_LOGFILE:-/tmp/music-tidy-install.log}"
        return 1
    fi

    mkdir -p "${TRIM_PKGVAR:-/tmp/music-tidy-var}" "${TRIM_PKGETC:-/tmp/music-tidy-etc}" 2>/dev/null
    rm -f "$PID_FILE" "$SOCKET_FILE"

    log_msg "启动服务: $PY $PY_SCRIPT --socket $SOCKET_FILE"
    nohup "$PY" "$PY_SCRIPT" \
        --socket "$SOCKET_FILE" \
        --config "${TRIM_PKGETC}/config.json" \
        --data "${TRIM_PKGVAR}" \
        >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"

    sleep 1
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PID_FILE" "$SOCKET_FILE"
        echo "服务启动失败，请查看日志: $LOG_FILE" > "${TRIM_TEMP_LOGFILE:-/tmp/music-tidy-install.log}"
        return 1
    fi
    # 等待 socket 就绪
    local c=0
    while [ ! -S "$SOCKET_FILE" ] && [ "$c" -lt 10 ]; do
        sleep 1
        c=$((c + 1))
    done
    return 0
}

stop_app() {
    if ! is_running; then
        rm -f "$PID_FILE" "$SOCKET_FILE"
        return 0
    fi
    local pid
    pid=$(cat "$PID_FILE" | tr -d '[:space:]')
    log_msg "停止服务 pid=$pid"
    kill "$pid" 2>/dev/null || true
    local count=0
    while kill -0 "$pid" 2>/dev/null && [ "$count" -lt 20 ]; do
        sleep 1
        count=$((count + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE" "$SOCKET_FILE"
    return 0
}

case "${1:-}" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    status)
        if is_running; then
            exit 0
        fi
        exit 3
        ;;
    *)
        exit 1
        ;;
esac
