#!/bin/bash
### This script is called after the user upgrades the application.

# 升级时保证配置与数据目录存在（幂等）
mkdir -p "${TRIM_PKGETC:-/tmp/music-tidy-etc}" "${TRIM_PKGVAR:-/tmp/music-tidy-var}" 2>/dev/null
if [ ! -f "${TRIM_PKGETC}/config.json" ]; then
    echo '{}' > "${TRIM_PKGETC}/config.json" 2>/dev/null
fi
exit 0
