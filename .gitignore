# Dependencies
node_modules/

# Local build and run data
var/
data/
*.log
*.pid

# Local toolchain / package cache (not part of the project)
.tools/
.npm-cache/

# OS generated
.DS_Store
Thumbs.db
desktop.ini

# Executable binaries
*.exe
fpk-package/fn-lx-player
fpk-package/app/fn-lx-player


# 本地开发环境（热加载脚本产生的数据）
#
# ⚠️ 2026-10-14 按 HANDOVER §8.6「六」修正：原来整目录 ignore，但**统一入口
# wsl-run.sh 与手机适配回归工具 measure-mobile.mjs 都在里面** —— 用 git 交付时
# 接手的人拿不到它们（§1 的第一条自检直接做不了）。改成 ignore 目录内容、
# 显式放行几个会被文档引用的工具；数据/日志/二进制仍然全部忽略。
.dev/*
!.dev/wsl-run.sh
!.dev/measure-mobile.mjs
!.dev/catalog-audit.mjs
!.dev/count-lines.sh
!.dev/count-tests.sh

# ──────────────────────────────────────────────────────────────
# 2026-10-06 补：体积大、且都能重新生成的东西
#
# 为什么现在补：这个项目之前一直没有版本库（没有 .git），
# 而顶层堆着 25 个 *.fpk（合计 152 MB，每个约 6 MB）——
# 一旦开始提交，历史里会堆着几十个「一次性」的安装包，
# 仓库很快就没法克隆了。这些都能重新打出来，不该进历史。
# ──────────────────────────────────────────────────────────────

# 打包产物（要留档就单独放 releases/ 并配 LFS，或干脆只留最新一个）
*.fpk

# 前端构建产物：Go 用 //go:embed all:dist 嵌进二进制，
# 但它是 `npm run build` / `scripts/build.sh` 生成的，不是源码。
backend/dist/

# 编辑器 / 同步工具的本地状态
.qsync-backup-*/
.refs/
.workbuddy-ai/

# Python 字节码（sidecar 自带代码也有 .py，import 时生成 __pycache__）。
# 不进仓库 —— 内容跟 .py 重复，IDE/打包都会重新生成。
__pycache__/
*.pyc
*.pyo

# 打包中间产物
fpk-package/app.tgz
*.pak

# 编译出来的 Go 二进制（打包时会放进 fpk-package/app/）。
# 旧的忽略规则只写了 fn-lx-player 这个老名字，改名成 yinshu-ai 之后就漏了 ——
# 14 MB 的东西，每改一次代码就变一次，进历史纯属浪费。
/fpk-package/app/yinshu-ai
/fpk-package/app/fn-lx-player
/fpk-package/fn-lx-player

# 第三方参考项目的源码副本：不进仓库（对方的 LICENSE 不明，见 docs/参考项目/README.md）。
# 只保留我们自己写的分析报告（*.md）。
docs/参考项目/music-tidy/server/
docs/参考项目/music-tidy/cmd/
docs/参考项目/music-tidy-1.14.0/server/

# ──────────────────────────────────────────────────────────────
# AI 工具 / 编辑器的本地状态（2026-10-30 补）
#
# 这些目录是各工具在自己磁盘上维护的索引、缓存、记忆与规则文件，
# 与曲率的运行无关；.graphflow/ + graphflow-out/ + .mnemon/ 合计约 6 MB，
# 且全部能从源码重建 —— 进历史只会让仓库越来越难克隆。
# ──────────────────────────────────────────────────────────────
.claude/
.dsh-vision-router/
.graphflow/
.graphflow-cache/
graphflow-out/
.mnemon/
PearAI/
# GraphFlow 自动生成的编辑器说明文件（AGENTS.md 与 .windsurfrules 内容完全相同）
AGENTS.md
GEMINI.md
.windsurfrules

# 飞牛视觉重构过程中的未接线草稿：从未被任何源码 import，
# 真正的实现已经落在 style.css + tailwind.config.js 里。只留本地磁盘备查。
frontend/.fnos_*.css
frontend/.fnos_*.js
